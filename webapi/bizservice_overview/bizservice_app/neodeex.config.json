{
  "$schema": "https://neodeex.github.io/doc/neodeex.config.schema.json",
  "database": {
    "defaultConnectionString": "PostgreSQL",
    "connectionStrings": {
      "PostgreSQL": {
        "type": "NeoDEEX.Data.NpgsqlClient.FoxNpgsqlDbAccess",
        "connectionString": "connectionStrings:PostgreSQL",
        "dbProfile": {
          "enable": true,
          "loggerName": "ConsoleLogger"
        },
        "userSecrets": true
      }
    }
  },
  "webapiServer": {
    "useTypeInfo": false,
    "returnServerInfo": true
  },
  "bizService": {
    "diagnostics": {
      "enable": true,
      "loggerName": "ConsoleLogger"
    },
    "perfLog": {
      "enable": true,
      "loggerName": "PerfLogger"
    },
    "modules": [ "BizLib1", "BizLib2.dll", "./legacy_biz/*.dll" ],
    "throwOnError": true,
    "useLoadContext": true,
    "isCollectible": false,
    "supportJsonType": false,
    "moduleGroups": {
      "group1": {
        "directory": "./modules",
        "pattern": "*.dll",
        "useLoadContext": true,
        "isCollectible": false
      }
    }
  },
  "dataService": {
    "diagnostics": {
      "enable": true,
      "loggerName": "ConsoleLogger",
      "detailedDbProfile": false
    },
    "perfLog": {
      "enable": true,
      "loggerName": "PerfLogger"
    }
  },
  "logging": {
    "filter": "Verbose",
    "loggers": {
      "bizservice_app": {
        "providerType": "NeoDEEX.Diagnostics.Loggers.FoxConsoleLoggerProvider"
      },
      "ConsoleLogger": {
        "providerType": "NeoDEEX.Diagnostics.Loggers.FoxConsoleLoggerProvider"
      },
      "FileLogger": {
        "providerType": "NeoDEEX.Diagnostics.Loggers.FoxTextFileLoggerProvider",
        "properties": {
          "filePrefix": "bizservice",
          "directory": "logs",
          "creation": "Daily"
        }
      },
      "PerfLogger": {
        "providerType": "NeoDEEX.Diagnostics.Loggers.FoxTextFileLoggerProvider",
        "properties": {
          "filePrefix": "bizservice_perf",
          "directory": "logs",
          "creation": "Daily"
        }
      }
    }
  }
}
